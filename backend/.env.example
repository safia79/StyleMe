# FR: Foundation — project setup (no feature logic yet)
# Copy this file to .env and adjust values if needed.

# Local SQLite file (relative to prisma/). Must match schema.prisma provider = "sqlite".
DATABASE_URL="file:./dev.db"
SESSION_SECRET="styleme-dev-secret-change-me"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# FR-03 / UC-04 clothing auto-tag (optional). OpenAI gpt-4o is used if OPENAI_API_KEY is set;
# otherwise Gemini if GEMINI_API_KEY or GOOGLE_API_KEY is set. Without a key, mock tags are used.
OPENAI_API_KEY=""
# GEMINI_API_KEY=""
